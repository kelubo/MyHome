# Object files
*.o

# Libraries
*.lib
*.a

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app

# ── 本地数据：数据库、各应用数据、备份（不入库，需自行备份） ──
data/
backups/
*.db
music.db

# ── Python 字节码（不应入库） ──
__pycache__/
*.pyc

# ── 旅行地图下钻 GeoJSON 本地缓存（运行时生成，不入库） ──
apps/travel/server/geo/

# ── 环境变量（含数据库密码，严禁入库；本地部署依赖它） ──
.env
.env.*
!.env.example

